{
  "name": "devstack-dashboard",
  "private": true,
  "version": "0.53.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "description": "Web dashboard for devstack, served by the hub",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:mock": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14",
    "workbox-window": "7.4.1"
  }
}
