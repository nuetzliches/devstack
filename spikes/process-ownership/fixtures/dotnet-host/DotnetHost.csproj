<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Generic host with a background worker; the web SDK only to get the hosting
       assemblies through the shared framework, without a package restore. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
